# Minimal OpenWrt SDK configuration for op-packages
#
# This .config enables the package build dependencies required by our 6
# packages without building an entire firmware image (which would require
# a target toolchain and significantly longer build time).
#
# Use:
#   cp tests/configs/sdk-minimal.config .config
#   make defconfig
#
# We deliberately keep the kernel-module set minimal (kmod-tun only) —
# libreswan/strongswan use userspace NSS/GnuTLS and don't require
# CONFIG_PACKAGE_kmod-ipsec* to compile. Pulling every kmod-* causes
# OpenWrt's package/kernel/linux/compile to assemble modules that
# reference kernel config symbols we don't enable in this slim config
# (e.g. CONFIG_AFS_FS=m for kmod-fs-afs), which then aborts the build.

CONFIG_TARGET_x86=y
CONFIG_TARGET_x86_64=y
CONFIG_TARGET_x86_64_Generic=y

# Crypto / SSL stack
CONFIG_PACKAGE_libopenssl=y
CONFIG_OPENSSL_WITH_TLS13=y

# Minimal kernel modules
CONFIG_PACKAGE_kmod-tun=y

# Build flags
CONFIG_PACKAGE_gc-sections=y
CONFIG_PKG_FORTIFY_SOURCE_2=y
CONFIG_PKG_RELRO_FULL=y
CONFIG_PKG_ASLR_PIE_REGULAR=y

# op-packages — explicitly enable every variant we compile. Without
# these, `make defconfig` may leave them at default (n for variant
# packages), which means `make package/op-packages/<pkg>/compile`
# returns "No rule to make target" because OpenWrt's package index
# has not emitted rules for unselected packages.
#
# openVPN uses 3 mutually-exclusive SSL backends. Two are validated here;
# the third is deliberately excluded.
#
# openvpn-wolfssl carries `@BROKEN` in its DEPENDS (same as
# openvpn/packages' own Makefile) and that flag is accurate: the wolfSSL
# backend does not build against OpenVPN 2.7.8. ssl_openssl.c still gets
# compiled for that variant and calls X509_STORE_CTX_set0_crls(), which
# wolfSSL's compat headers do not provide:
#     ssl_openssl.c:321:5: error: implicit declaration of function
#     'X509_STORE_CTX_set0_crls' [-Wimplicit-function-declaration]
# Selecting it makes the whole openvpn directory compile fail, which also
# loses the openssl/mbedtls artifacts, so it stays off until that backend
# is ported. CONFIG_BROKEN must therefore stay unset as well.
CONFIG_OPENVPN_OPENSSL=y
CONFIG_PACKAGE_openvpn-openssl=y
CONFIG_PACKAGE_openvpn-mbedtls=y
# CONFIG_PACKAGE_openvpn-wolfssl is intentionally omitted.
CONFIG_PACKAGE_openvpn-easy-rsa=y
CONFIG_PACKAGE_libreswan=y
CONFIG_PACKAGE_strongswan-default=y
CONFIG_PACKAGE_softethervpn-base=y
CONFIG_PACKAGE_softethervpn-server=y
CONFIG_PACKAGE_softethervpn-bridge=y
CONFIG_PACKAGE_softethervpn-client=y
CONFIG_PACKAGE_softethervpn5-libs=y
CONFIG_PACKAGE_softethervpn5-server=y
CONFIG_PACKAGE_softethervpn5-bridge=y
CONFIG_PACKAGE_softethervpn5-client=y
